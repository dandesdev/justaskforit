# Required. Get a key at https://aistudio.google.com/apikey
# Server-side only — never exposed to the browser.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here

# Optional. Override the Gemini model (defaults to gemini-3.6-flash).
# GEMINI_MODEL=gemini-3.6-flash

# Optional. Real email delivery for AI-rendered contact forms (via resend.com).
# When unset, the AI is told forms are disabled and renders direct mailto: links instead.
# RESEND_API_KEY=re_your-resend-key
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=justaskforit <onboarding@resend.dev>
